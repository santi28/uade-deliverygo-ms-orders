# Copiar a .env y ajustar. El .env no se commitea (sin secretos en el repo).
#
# El .env lo lee docker compose para crear la base. La app (perfil dev) lee las mismas
# variables del entorno; si cambias la contrasena aca, exportala tambien donde corras la
# app, o no va a poder conectarse.

# Base de datos del modulo Pedidos (docker-compose.yml, perfil dev)
POSTGRES_USER=deliverygo
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=deliverygo_pedidos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Puerto HTTP de la app
SERVER_PORT=8080
