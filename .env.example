# Copiar a .env y ajustar. El .env no se commitea (sin secretos en el repo).
#
# El .env lo lee docker compose para crear la base y para pasarle las credenciales al
# contenedor de la app. Si en cambio corres la app fuera de Docker (desde el IDE o con
# ./mvnw spring-boot:run), exporta las mismas variables en ese entorno: el .env lo lee
# Docker, no Spring.
#
# POSTGRES_HOST y POSTGRES_PORT son para ese caso, la app fuera de Docker. El contenedor
# de la app no los usa: dentro de la red de compose la base es el servicio `postgres` en
# su puerto interno.

# Base de datos del modulo Pedidos (docker-compose.yml, perfil dev)
POSTGRES_USER=deliverygo
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=deliverygo_pedidos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Puerto HTTP de la app
SERVER_PORT=8080
